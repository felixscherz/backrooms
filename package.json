{
  "name": "backrooms",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "bin": {
    "backrooms": "src/main.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "build": "bun build --compile src/main.ts --outfile dist/backrooms",
    "format": "bunx prettier@3.3.3 --write \"src/**/*.ts\" \"compat/**/*.ts\"",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/main.ts --outfile dist/backrooms-linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
